{
  "name": "kecpa-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node scripts/serve-static.mjs",
    "test:security": "node --test scripts/security.test.js",
    "test:e2e": "playwright test",
    "check:site": "node scripts/check-site.mjs",
    "check:links": "node scripts/check-site.mjs --external",
    "check:grammar": "node scripts/check-grammar.mjs",
    "lint:html": "html-validate index.html privacy.html terms.html 404.html",
    "lint:spelling": "cspell --no-progress",
    "check": "npm run test:security && npm run check:site && npm run lint:html && npm run lint:spelling && npm run test:e2e"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "clsx": "2.1.1",
    "framer-motion": "14.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "autoprefixer": "10.6.1",
    "cspell": "10.4.0",
    "html-validate": "11.17.0",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
