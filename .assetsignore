# Deny by default. Only these reviewed public files may be uploaded.
*
!/index.html
!/index.css
!/script.js
!/privacy.html
!/terms.html
!/404.html
!/404.css
!/logo.png
!/logo-modified.png
!/og-image.jpg
!/robots.txt
!/sitemap.xml
!/llms.txt
# Wrangler reads _headers and _redirects as metadata, not public assets.
!/.well-known/
!/.well-known/security.txt

!/financial-hero.webp
!/financial-hero-small.webp
!/financial-accounting.webp
!/financial-accounting-small.webp
!/financial-advisory.webp
!/financial-advisory-small.webp
!/financial-tax.webp
!/financial-tax-small.webp
!/financial-bookkeeping.webp
!/financial-bookkeeping-small.webp

# Intro video (web sizes only; the 4K master stays in output/, never deployed)
!/kecpa-video-1080.mp4
!/kecpa-video-720.mp4
!/kecpa-video-1080.av1.mp4
!/kecpa-video-720.av1.mp4
!/kecpa-video-poster.webp
!/kecpa-video.en.vtt

# Self-hosted fonts, icon subset, shared styles and small brand images
!/fonts.css
!/legal.css
!/fonts/
!/fonts/inter-latin.woff2
!/fonts/playfair-latin.woff2
!/fonts/playfair-italic-latin.woff2
!/fonts/fa-icons.woff2
!/logo-mark.webp
!/favicon-32.png
!/favicon-192.png
!/apple-touch-icon.png
