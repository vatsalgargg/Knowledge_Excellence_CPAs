# Security headers — applied by Cloudflare Workers at the edge
# Ref: https://developers.cloudflare.com/workers/static-assets/headers/

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data: https://hits.sh; media-src 'self'; connect-src 'self' https://formspree.io; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action https://formspree.io; upgrade-insecure-requests
  Cross-Origin-Opener-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none

# Content negotiation — tell caches that "/" can vary by Accept header.
# The worker serves text/markdown to AI agents, text/html to browsers.
/
  Vary: Accept

# llms.txt — served directly as Markdown for AI agents that fetch it explicitly.
/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Vulnerability disclosure metadata (RFC 9116).
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
